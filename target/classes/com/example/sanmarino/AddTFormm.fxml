<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="700.0" prefWidth="1000.0" spacing="30.0"
      style="-fx-background-color: #f4f4f4; -fx-padding: 40;"
      xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.sanmarino.FormController">

    <children>
        <HBox alignment="CENTER_LEFT">
            <children>
                <Label text="Add New Transaction"
                       style="-fx-background-color: #148C9E;
                          -fx-text-fill: white;
                          -fx-font-size: 24px;
                          -fx-font-weight: bold;
                          -fx-padding: 12 50;
                          -fx-background-radius: 30;" />
            </children>
        </HBox>

        <VBox spacing="25.0"
              style="-fx-background-color: white;
                   -fx-padding: 40;
                   -fx-background-radius: 20;
                   -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 15, 0, 0, 5);">

            <children>
                <GridPane hgap="30.0" vgap="25.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                    </rowConstraints>

                    <children>
                        <VBox spacing="8.0">
                            <children>
                                <Label text="Transaction ID" style="-fx-text-fill: #555; -fx-font-weight: bold;" />
                                <TextField fx:id="getTransactionID" prefHeight="50.0" promptText="Enter ID..."
                                           style="-fx-background-radius: 15; -fx-border-color: #ddd; -fx-border-radius: 15; -fx-padding: 0 15;" />
                            </children>
                        </VBox>

                        <VBox spacing="8.0" GridPane.columnIndex="1">
                            <children>
                                <Label text="Form ID" style="-fx-text-fill: #555; -fx-font-weight: bold;" />
                                <TextField fx:id="getFormID" prefHeight="50.0" promptText="Enter Form ID..."
                                           style="-fx-background-radius: 15; -fx-border-color: #ddd; -fx-border-radius: 15; -fx-padding: 0 15;" />
                            </children>
                        </VBox>

                        <VBox spacing="8.0" GridPane.rowIndex="1">
                            <children>
                                <Label text="Amount (PHP)" style="-fx-text-fill: #555; -fx-font-weight: bold;" />
                                <TextField fx:id="transactAmountField" prefHeight="50.0" promptText="0.00"
                                           style="-fx-background-radius: 15; -fx-border-color: #ddd; -fx-border-radius: 15; -fx-padding: 0 15;" />
                            </children>
                        </VBox>

                        <VBox spacing="8.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <children>
                                <Label text="Payment Method" style="-fx-text-fill: #555; -fx-font-weight: bold;" />
                                <ChoiceBox fx:id="payChoiceBox" prefHeight="50.0" prefWidth="500.0"
                                           style="-fx-background-radius: 15; -fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 15;" />
                            </children>
                        </VBox>
                    </children>
                </GridPane>

                <HBox alignment="CENTER_RIGHT" spacing="20.0">
                    <children>
                        <Button mnemonicParsing="false" text="Cancel"
                                style="-fx-background-color: transparent; -fx-text-fill: #777; -fx-cursor: hand; -fx-font-weight: bold;" />

                        <Button fx:id="formAddButton" onAction="#AddbuttonForAll" prefHeight="50.0" prefWidth="180.0"
                                text="CONFIRM POST"
                                style="-fx-background-color: #148C9E; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 25; -fx-cursor: hand;" />
                    </children>
                    <VBox.margin>
                        <Insets top="20.0" />
                    </VBox.margin>
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>