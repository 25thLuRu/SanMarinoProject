<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<StackPane prefHeight="500.0" prefWidth="700.0" style="-fx-background-color: #f4f7f6;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.sanmarino.LoginController">
    <children>
        <VBox alignment="CENTER" maxWidth="350.0" spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
            <padding>
                <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
            </padding>
            <children>
                <ImageView fx:id="imgLogo" fitHeight="250.0" fitWidth="250.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@LOGO.png" />
                    </image>
                </ImageView>

                <VBox alignment="CENTER" spacing="5.0">
                    <children>
                        <Label text="SAN MARINO" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                        <Label text="System Login" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;" />
                    </children>
                </VBox>

                <VBox spacing="15.0">
                    <children>
                        <VBox spacing="5.0">
                            <Label text="Username" style="-fx-font-weight: bold; -fx-text-fill: #34495e;" />
                            <TextField fx:id="txtUsername" prefHeight="35.0" promptText="Enter your username" style="-fx-background-radius: 5;" />
                        </VBox>

                        <VBox spacing="5.0">
                            <Label text="Password" style="-fx-font-weight: bold; -fx-text-fill: #34495e;" />
                            <PasswordField fx:id="txtPassword" prefHeight="35.0" promptText="Enter your password" style="-fx-background-radius: 5;" />
                        </VBox>
                    </children>
                </VBox>

                <Button fx:id="btnLogin" onAction="#handleLogin" prefHeight="40.0" prefWidth="300.0"
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;"
                        text="LOG IN" />

                <Label fx:id="lblError" textFill="#e74c3c" wrapText="true" alignment="CENTER" />
            </children>
        </VBox>
    </children>
</StackPane>